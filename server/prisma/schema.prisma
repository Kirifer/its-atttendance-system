// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  email              String   @unique
  password           String
  profilePic         String?
  role               Role     @default(USER)   // ⬅ NEW
  created_at         DateTime @default(now())
  reset_token        String?
  reset_token_expiry DateTime?

  leaves      Leave[]
  attendance  Attendance[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
}

model Leave {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  startDate   DateTime
  endDate     DateTime
  leaveType   LeaveType
  status      LeaveStatus @default(PENDING)
  reason      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  attendance Attendance[]

  @@index([userId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

model Attendance {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  date        DateTime         // the date of attendance
  timeIn     DateTime?        // optional, user may not have timed in
  timeOut    DateTime?        // optional, user may not have timed out
  status      AttendanceStatus @default(PRESENT)
  leaveId     Int?             // optional reference to Leave if attendance is ON_LEAVE
  leave       Leave?           @relation(fields: [leaveId], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, date])     // one attendance record per user per day
  @@index([userId])
  @@index([date])
  @@index([status])
}