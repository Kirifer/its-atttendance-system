// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  email              String    @unique
  password           String
  profilePic         String?
  role               Role      @default(USER)
  created_at         DateTime  @default(now())
  reset_token        String?
  reset_token_expiry DateTime?

  leaves      Leave[]
  attendance  Attendance[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  VACATION
  HOLIDAY
  SICK
  OFFSET
}

model Leave {
  id        String      @id @default(uuid())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime
  leaveType LeaveType
  status    LeaveStatus @default(PENDING)
  reason    String?
  attachment String? 
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  attendance Attendance[]

  @@index([userId])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  TARDY
  ABSENT
  ON_LEAVE
}

model Attendance {
  id      String             @id @default(uuid())
  userId  Int
  user    User             @relation(fields: [userId], references: [id])
  date    DateTime
  timeIn  DateTime?
  lunchOut DateTime?
  lunchIn DateTime?
  timeOut DateTime?
  status  AttendanceStatus @default(PRESENT)

  tardinessMinutes        Int   @default(0)
  lunchTardinessMinutes   Int   @default(0)
  totalWorkHours Float? 

  leaveId String?
  leave   Leave?           @relation(fields: [leaveId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model TimeAdjustment {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  details   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}